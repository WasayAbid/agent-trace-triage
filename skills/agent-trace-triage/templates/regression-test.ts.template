/**
 * Regression test generated from agent trace triage.
 * Incident: {{INCIDENT_ID}}
 * Trace: {{TRACE_FILE}}
 * Bucket: {{BUCKET}}
 */
import { readFileSync, existsSync } from "node:fs";
import { describe, it, expect } from "vitest";

const TRACE_FILE = "{{TRACE_FILE}}";
const INCIDENT_ID = "{{INCIDENT_ID}}";

function loadToolNames(): string[] {
  if (!existsSync(TRACE_FILE)) {
    return [];
  }
  const names: string[] = [];
  for (const line of readFileSync(TRACE_FILE, "utf8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    const row = JSON.parse(trimmed) as Record<string, unknown>;
    if (["tool_call", "tool", "execute_tool"].includes(String(row.type))) {
      names.push(String(row.tool ?? row.tool_name ?? row.name));
    }
  }
  return names;
}

describe(`agent regression: ${INCIDENT_ID}`, () => {
  it("no unbounded tool loop in trace", () => {
    const calls = loadToolNames();
    if (calls.length < 3) return;

    let maxRepeat = 1;
    let streak = 1;
    for (let i = 1; i < calls.length; i++) {
      streak = calls[i] === calls[i - 1] ? streak + 1 : 1;
      maxRepeat = Math.max(maxRepeat, streak);
    }
    expect(maxRepeat).toBeLessThan(3);
  });

  it.todo("implement domain-specific agent assertion");
});
